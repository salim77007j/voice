// Segmented LED level meter (Phase 7.2): vertical bar of 26 LED
// segments, green → yellow → red over the −60…0 dBFS meter scale
// (dB-linear mapping from mvl-core::spectrum::db_to_meter), with a white
// peak-hold line and a latching CLIP indicator on top. One meter per
// channel; mono sessions drive both meters from the same value.

import { Theme } from "../theme.slint";

export component LevelMeter inherits Rectangle {
    in property <float> level;      // 0..1 (dB-linear, 0 = −60 dBFS)
    in property <float> peak;       // 0..1 peak hold
    in property <bool> clip-latch: false;
    in property <string> label: "L";

    width: 18px;
    background: Theme.recess;
    border-width: 1px;
    border-color: #0D0F12;
    border-radius: Theme.radius-control;

    property <int> segments: 24;
    property <length> led-gap: 1px;
    property <length> led-h: (self.height - 16px - root.led-gap * (root.segments - 1)) / root.segments;

    // segment color by position on the meter scale:
    //   < 62 % green · 62–86 % yellow · > 86 % red
    function seg-color(fraction: float) -> color {
        if (fraction < 0.62) { return #2FBF71; }
        else if (fraction < 0.86) { return #ECC000; }
        return #FF4040;
    }

    // ---- clip LED ------------------------------------------------------------
    Rectangle {
        x: 2px; y: 2px;
        width: parent.width - 4px;
        height: 7px;
        border-radius: 1.5px;
        background: root.clip-latch ? #FF3333 : #1A1D21;
        border-width: 1px;
        border-color: root.clip-latch ? #FF8888 : #0D0F12;

        if root.clip-latch: Rectangle {
            x: 1px; y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: 1px;
            background: #FF333355;
        }
    }

    // ---- LED segments (bottom-up) -----------------------------------------------
    for seg[i] in root.segments: Rectangle {
        x: 3px;
        width: parent.width - 6px;
        height: root.led-h;
        y: parent.height - 14px - (i + 1) * (root.led-h + root.led-gap);
        border-radius: 1px;
        background: root.level * root.segments >= i + 1
            ? root.seg-color((i + 1) / root.segments)
            : #22252A;
    }

    // ---- peak-hold line ------------------------------------------------------------
    Rectangle {
        x: 3px;
        width: parent.width - 6px;
        height: 2px;
        y: parent.height - 14px - root.peak * (parent.height - 16px) - 1px;
        background: Theme.peak-cap;
        opacity: root.peak > 0.005 ? 0.9 : 0.0;
    }

    // ---- channel label ------------------------------------------------------------
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-family: Theme.font-mono;
        font-size: 9px;
        font-weight: 600;
        x: 0;
        width: parent.width;
        height: 11px;
        y: parent.height - 11px;
        horizontal-alignment: TextHorizontalAlignment.center;
    }
}
