// Four-band parametric EQ panel (Phase 8.3): the first V2 rack module —
// a real channel EQ wired 1:1 to mvl-core's RBJ biquads.
//
// Anatomy (rack conventions, mirror of the channel-strip row):
//
//   ┌ header ─ LED · EQUALIZER · [ON/BYPASS] · PRESET [ComboBox] · [Reset]
//   ├ body ── [ response curve well (log 20 Hz…20 kHz, ±24 dB view) ]
//   │         [ LOW SHELF ][ LOW-MID ][ HIGH-MID ][ HIGH SHELF ] strips
//
// Every strip: bypass LED button + three knobs (frequency / Q / gain —
// frequency and Q sweep logarithmically) + a mono readout line.
//
// The curve and the grid stay LTR in RTL locales (frequency axes are an
// engineering-graph convention — same decision as the RTA spectrum and
// the timeline); the surrounding layout mirrors like every other rack
// row. All data flows in from the controller; the widget proposes
// changes through callbacks and never fabricates values.

import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";
import { TextButton } from "buttons.slint";
import { Knob } from "knob.slint";
import { LedDot, EngravedLabel } from "rack.slint";
import { ComboBox } from "std-widgets.slint";

// One band's UI state, published by the controller (canonical values +
// preformatted mono texts; the widget only displays and proposes).
// `kind` selects the (translated) band title: 0 low shelf, 1 low-mid,
// 2 high-mid, 3 high shelf.
export struct EqBandUi {
    kind: int,
    freq: float,
    q: float,
    gain: float,
    freq-text: string,
    q-text: string,
    gain-text: string,
    enabled: bool,
    neutral-freq: float,
}

export component EqBandStrip inherits Rectangle {
    in property <EqBandUi> band;
    in property <int> index;
    in property <bool> master-active: true;
    callback param-changed(int /*band*/, int /*param*/, float);
    callback band-toggled(int);

    // translated band title (kind → string)
    function band-title(kind: int) -> string {
        if (kind == 0) { return @tr("Low Shelf"); }
        else if (kind == 1) { return @tr("Low-Mid Bell"); }
        else if (kind == 2) { return @tr("High-Mid Bell"); }
        return @tr("High Shelf");
    }

    background: #202329;
    border-width: 1px;
    border-color: #191C20;
    border-radius: Theme.radius-panel;
    min-width: 132px;
    horizontal-stretch: 0;
    opacity: root.band.enabled && root.master-active ? 1.0 : 0.55;

    // channel-colour rule on the leading edge, lit when the band cuts/boosts
    property <bool> off-neutral: Math.abs(root.band.gain) > 0.000001;
    Rectangle {
        x: 0; y: 6px;
        width: 2px;
        height: parent.height - 12px;
        background: root.band.enabled && root.off-neutral && root.master-active
            ? Theme.accent : #34383E;
    }

    VerticalLayout {
        padding: 6px;
        padding-left: 8px;
        spacing: 4px;

        // header: bypass toggle (LED + title, whole strip is the button)
        ta := TouchArea {
            height: 18px;
            clicked => { root.band-toggled(root.index); }
            accessible-role: AccessibleRole.button;
            accessible-label: @tr("Bypass") + " " + band-title(root.band.kind);
        }
        FlexboxLayout {
            height: 18px;
            flex-direction: Translations.rtl ? row-reverse : row;
            alignment: LayoutAlignment.stretch;
            spacing: 4px;

            Rectangle {
                width: 16px; height: 16px;
                border-radius: Theme.radius-control;
                background: root.band.enabled ? #2E3238 : #26292E;
                border-width: 1px;
                border-color: root.band.enabled ? Theme.accent-dim : Theme.border;
                cross-axis-self-alignment: CrossAxisAlignment.center;

                LedDot {
                    lit: root.band.enabled;
                    led-color: Theme.accent;
                    d: 6px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            Text {
                text: band-title(root.band.kind);
                color: root.band.enabled ? Theme.text : Theme.text-muted;
                font-family: Translations.font-family;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.6px;
                vertical-alignment: TextVerticalAlignment.center;
                horizontal-stretch: 1;
                overflow: elide;
                cross-axis-self-alignment: CrossAxisAlignment.center;
            }
        }

        // knobs: frequency (log) · Q (log) · gain (linear)
        FlexboxLayout {
            height: 46px;
            flex-direction: Translations.rtl ? row-reverse : row;
            alignment: LayoutAlignment.space-around;
            cross-axis-alignment: CrossAxisAlignment.center;

            Knob {
                size: 44px;
                value: root.band.freq;
                minimum: 20; maximum: 20000;
                neutral: root.band.neutral-freq;
                step: 1; coarse-step: 100;
                logarithmic: true;
                enabled: root.band.enabled && root.master-active;
                changed(v) => { root.param-changed(root.index, 0, v); }
            }
            Knob {
                size: 44px;
                value: root.band.q;
                minimum: 0.1; maximum: 10;
                neutral: 0.707;
                step: 0.01; coarse-step: 0.5;
                logarithmic: true;
                enabled: root.band.enabled && root.master-active;
                changed(v) => { root.param-changed(root.index, 1, v); }
            }
            Knob {
                size: 44px;
                value: root.band.gain;
                minimum: -24; maximum: 24;
                neutral: 0;
                step: 0.1; coarse-step: 3;
                enabled: root.band.enabled && root.master-active;
                changed(v) => { root.param-changed(root.index, 2, v); }
            }
        }

        // knob labels
        FlexboxLayout {
            height: 12px;
            flex-direction: Translations.rtl ? row-reverse : row;
            alignment: LayoutAlignment.space-around;

            Text {
                text: @tr("Freq");
                color: Theme.text-muted;
                font-family: Theme.font-mono;
                font-size: 8px;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Text {
                text: "Q";
                color: Theme.text-muted;
                font-family: Theme.font-mono;
                font-size: 8px;
                vertical-alignment: TextVerticalAlignment.center;
            }
            Text {
                text: @tr("Gain");
                color: Theme.text-muted;
                font-family: Theme.font-mono;
                font-size: 8px;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }

        // readout: freq + gain (Q on hover is overkill; the knob shows it)
        Text {
            text: root.band.freq-text + "  " + root.band.gain-text;
            color: root.band.enabled && root.off-neutral ? Theme.accent : Theme.text-2nd;
            font-family: Theme.font-mono;
            font-size: 10px;
            horizontal-alignment: TextHorizontalAlignment.center;
            overflow: elide;
        }
    }
}

export component EqPanel inherits Rectangle {
    // ---- contract (Rust-owned state) ------------------------------------
    in property <bool> has-audio: false;
    in property <bool> eq-enabled: true;
    in property <bool> eq-active: false;       // any band cutting/boosting
    in property <[EqBandUi]> bands;
    in property <string> curve-line;           // path commands, viewbox 1000×260
    in property <string> curve-fill;
    in-out property <int> preset-index;

    // translated preset labels (display order == EqPreset order in Rust)
    property <[string]> preset-labels: [
        @tr("Flat"),
        @tr("Vocal Presence"),
        @tr("De-Mud"),
        @tr("Air Boost"),
        @tr("De-Harsh"),
    ];

    callback set-eq-enabled(bool);
    callback band-param-changed(int, int, float);
    callback band-toggled(int);
    callback preset-chosen(int);
    callback reset-eq();

    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-panel;

    // bevel light
    Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: 1px;
        background: #FFFFFF1E;
    }

    VerticalLayout {
        padding: Theme.space-2;
        padding-top: 6px;
        spacing: 6px;

        // ---- header ------------------------------------------------------
        FlexboxLayout {
            height: 26px;
            flex-direction: Translations.rtl ? row-reverse : row;
            alignment: LayoutAlignment.stretch;
            spacing: Theme.space-2;

            LedDot {
                lit: root.eq-enabled && root.eq-active;
                led-color: Theme.accent;
                d: 8px;
                cross-axis-self-alignment: CrossAxisAlignment.center;
            }
            EngravedLabel {
                text: @tr("EQUALIZER");
                font-size: 11px;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Rectangle { width: 6px; height: 1px; }

            TextButton {
                text: root.eq-enabled ? @tr("ON") : @tr("BYPASS");
                tooltip: @tr("Bypass the whole equalizer (bit-exact)");
                active: root.eq-enabled;
                min-w: 76px;
                clicked => { root.set-eq-enabled(!root.eq-enabled); }
                cross-axis-self-alignment: CrossAxisAlignment.center;
            }

            Rectangle { height: 1px; horizontal-stretch: 1; }

            Text {
                text: @tr("Preset");
                color: Theme.text-muted;
                font-family: Theme.font-mono;
                font-size: 10px;
                vertical-alignment: TextVerticalAlignment.center;
                cross-axis-self-alignment: CrossAxisAlignment.center;
            }
            ComboBox {
                model: root.preset-labels;
                current-index <=> root.preset-index;
                selected => { root.preset-chosen(self.current-index); }
                min-width: 150px;
                cross-axis-self-alignment: CrossAxisAlignment.center;
            }
            TextButton {
                text: @tr("Reset");
                tooltip: @tr("Reset the equalizer to flat");
                min-w: 64px;
                clicked => { root.reset-eq(); }
                cross-axis-self-alignment: CrossAxisAlignment.center;
            }
        }

        // ---- body: curve + band strips ------------------------------------
        FlexboxLayout {
            vertical-stretch: 1;
            flex-direction: Translations.rtl ? row-reverse : row;
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.stretch;
            spacing: Theme.space-2;

            // response curve: recessed well, LTR frequency axis always
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.recess;
                border-width: 1px;
                border-color: #0D0F12;
                border-radius: Theme.radius-control;

                // inner top shadow
                Rectangle {
                    x: 1px; y: 1px;
                    width: parent.width - 2px;
                    height: 2px;
                    background: #00000088;
                }

                // horizontal dB rules: +24 / 0 / −24
                for rule in [0.038, 0.5, 0.962]: Rectangle {
                    y: parent.height * rule;
                    x: 4px;
                    width: parent.width - 8px;
                    height: 1px;
                    background: rule == 0.5 ? #FFFFFF22 : #FFFFFF09;
                }
                // vertical frequency rules: 100 Hz / 1 kHz / 10 kHz
                for fx in [0.233, 0.566, 0.899]: Rectangle {
                    x: 4px + (parent.width - 8px) * fx;
                    y: 4px;
                    width: 1px;
                    height: parent.height - 8px;
                    background: #FFFFFF09;
                }

                // the response itself (controller-computed RBJ math)
                curve := Path {
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    x: 4px;
                    y: 4px;
                    viewbox-width: 1000;
                    viewbox-height: 260;
                    fit: ImageFit.fill;   // stretch the fixed viewbox to the well
                    commands: root.curve-fill;
                    fill: root.eq-enabled && root.eq-active ? Theme.accent-soft : #FFFFFF08;
                }
                Path {
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    x: 4px;
                    y: 4px;
                    viewbox-width: 1000;
                    viewbox-height: 260;
                    fit: ImageFit.fill;
                    commands: root.curve-line;
                    stroke: root.eq-enabled && root.eq-active ? Theme.accent : Theme.text-muted;
                    stroke-width: 2px;
                }

                // axis captions (mono, engraved; dB at the right edge so
                // they never collide with the 20 Hz caption)
                Text {
                    text: "+24";
                    x: parent.width - 32px; y: 2px;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 8px;
                }
                Text {
                    text: "0 dB";
                    x: parent.width - 32px;
                    y: parent.height * 0.5 - 6px;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 8px;
                }
                Text {
                    text: "−24";
                    x: parent.width - 32px;
                    y: parent.height * 0.962 - 10px;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 8px;
                }
                Text {
                    text: "20 Hz";
                    x: 4px;
                    y: parent.height - 12px;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 8px;
                }
                Text {
                    text: "100";
                    x: parent.width * 0.233 - 8px;
                    y: parent.height - 12px;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 8px;
                }
                Text {
                    text: "1 kHz";
                    x: parent.width * 0.566 - 10px;
                    y: parent.height - 12px;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 8px;
                }
                Text {
                    text: "10 kHz";
                    x: parent.width * 0.899 - 14px;
                    y: parent.height - 12px;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 8px;
                }
                Text {
                    text: "20 kHz";
                    x: parent.width - 34px;
                    y: parent.height - 12px;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 8px;
                }
            }

            // four band strips
            for band[i] in root.bands: EqBandStrip {
                band: band;
                index: i;
                master-active: root.eq-enabled;
                param-changed(b, p, v) => { root.band-param-changed(b, p, v); }
                band-toggled(b) => { root.band-toggled(b); }
            }
        }
    }
}
