// Rotary knob (Phase 7.2, Audioprecise Pro reference): skeuomorphic
// machined control — beveled rim, brushed body, bright indicator line,
// tick marks around the sweep.
//
// Interaction (channel-strip conventions):
//   · drag vertically over the knob to change the value (~150 px for the
//     full range; Shift = fine, 1/8 of the rate)
//   · mouse wheel steps by `step`
//   · arrow keys step by `step`, Shift+arrows by `coarse-step`
//   · Home jumps to neutral, End to maximum, double-click resets
//
// Phase 8.3: `logarithmic` maps the sweep through log-frequency (EQ
// frequency + Q knobs) — drag/wheel/keys all move in fraction space, so
// a linear knob behaves exactly as before and a log knob sweeps its
// decades evenly. `step` stays in VALUE units (converted to a fraction
// of the range internally).
//
// The knob never emits unclamped values and never mutates on its own:
// like PrecisionSlider it proposes candidates through `changed(float)`
// and the Rust controller remains the single source of truth.

import { Theme } from "../theme.slint";

export component Knob inherits Rectangle {
    // ---- contract -------------------------------------------------------
    in property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> neutral;
    in property <float> step;
    in property <float> coarse-step;
    in property <length> size: 54px;
    in property <color> accent: Theme.accent;
    in property <bool> logarithmic: false;   // log sweep (EQ freq/Q)
    in property <bool> enabled: true;        // greyed + inert when false
    callback changed(float);
    callback reset-pressed();

    // ---- derived --------------------------------------------------------
    // fraction of the sweep 0..1, log-mapped when `logarithmic`.
    // (Slint's Math.log takes an explicit base — any base works here as
    // long as both sides use the same one.)
    out property <float> fraction: root.logarithmic
        ? Math.log(root.value / root.minimum, 10) / Math.log(root.maximum / root.minimum, 10)
        : (root.value - root.minimum) / (root.maximum - root.minimum);
    property <bool> on-neutral: Math.abs(root.value - root.neutral) < 0.000001;
    property <angle> ang: -135deg + 270deg * root.fraction;
    // pixels of vertical drag for the full range
    property <float> drag-range: 150;
    property <length> drag-last-y: 0px;
    property <bool> fine-drag: false;   // Shift held when the drag started
    // one `step` expressed in fraction units (linear step → fraction)
    property <float> step-fraction: root.step / (root.maximum - root.minimum);
    property <float> coarse-fraction: root.coarse-step / (root.maximum - root.minimum);

    width: root.size;
    height: root.size;

    function value-from-fraction(f: float) -> float {
        return root.logarithmic
            ? root.minimum * Math.pow(root.maximum / root.minimum, f)
            : root.minimum + (root.maximum - root.minimum) * f;
    }

    // ---- tick ring (behind the body) ------------------------------------
    // seven ticks over the 270° sweep, rotated the same way as the
    // indicator: full-size transparent carrier, child at the top.
    for tick[i] in 7: Rectangle {
        width: parent.width + 6px;
        height: parent.height + 6px;
        x: -3px;
        y: -3px;
        transform-rotation: -135deg + 45deg * i;

        Rectangle {
            width: 2px;
            height: 3px;
            border-radius: 1px;
            y: 1px;
            x: (parent.width - self.width) / 2;
            background: i == 3 ? Theme.edge : Theme.border;
        }
    }

    // ---- bevel rim --------------------------------------------------------
    Rectangle {
        width: 100%; height: 100%;
        border-radius: self.width / 2;
        background: @radial-gradient(circle at self.width * 0.38 self.height * 0.32, #5A6169 0%, #343940 45%, #16181C 100%);
        border-width: 1px;
        border-color: #0E1013;

        // bottom rim shadow (the seated-in-panel depth cue)
        Rectangle {
            x: 2px;
            y: parent.height * 0.62;
            width: parent.width - 4px;
            height: parent.height * 0.36;
            border-radius: self.width / 2;
            background: #00000055;
        }
    }

    // ---- knob body --------------------------------------------------------
    Rectangle {
        x: 5px; y: 5px;
        width: parent.width - 10px;
        height: parent.height - 10px;
        border-radius: self.width / 2;
        background: ta.has-hover
            ? @radial-gradient(circle at self.width * 0.36 self.height * 0.28, #565D66 0%, #2E3238 50%, #14161A 100%)
            : @radial-gradient(circle at self.width * 0.36 self.height * 0.28, #4E545C 0%, #26292E 50%, #121418 100%);
        border-width: 1px;
        border-color: #0C0E10;

        // brushed-metal sheen (top-left crescent)
        Rectangle {
            width: 52%; height: 28%;
            border-radius: self.width / 2;
            x: parent.width * 0.12;
            y: parent.height * 0.08;
            background: #FFFFFF1E;
        }
    }

    // ---- indicator (rotates around the knob center) -----------------------
    Rectangle {
        width: 100%; height: 100%;
        transform-rotation: root.ang;

        Rectangle {
            x: (parent.width - 3px) / 2;
            y: 8px;
            width: 3px;
            height: parent.height * 0.34;
            border-radius: 1.5px;
            background: root.on-neutral ? Theme.text-2nd : root.accent;
            // glowing tip: bright core over the gold body
            Rectangle {
                width: 100%;
                height: 30%;
                background: #FFFFFFB0;
            }
        }
    }

    // ---- center cap ---------------------------------------------------------
    Rectangle {
        width: 26%; height: 26%;
        border-radius: self.width / 2;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: @radial-gradient(circle at self.width * 0.40 self.height * 0.34, #565C64 0%, #23262B 70%, #15171B 100%);
        border-width: 1px;
        border-color: #0E1013;
    }

    // ---- interaction ----------------------------------------------------------
    fs := FocusScope {
        width: 100%; height: 100%;
        enabled: root.enabled;
        key-pressed(ev) => {
            if (ev.text == Key.LeftArrow || ev.text == Key.DownArrow) {
                root.propose(root.fraction - (ev.modifiers.shift ? root.coarse-fraction : root.step-fraction));
                return accept;
            } else if (ev.text == Key.RightArrow || ev.text == Key.UpArrow) {
                root.propose(root.fraction + (ev.modifiers.shift ? root.coarse-fraction : root.step-fraction));
                return accept;
            } else if (ev.text == Key.Home) {
                root.changed(root.neutral);
                return accept;
            } else if (ev.text == Key.End) {
                root.changed(root.maximum);
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        width: 100%; height: 100%;
        enabled: root.enabled;
        clicked => { fs.focus(); }
        double-clicked => { root.reset-pressed(); }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left
                && ev.kind == PointerEventKind.down) {
                fs.focus();
                root.drag-last-y = self.mouse-y;
                root.fine-drag = ev.modifiers.shift;
            }
        }
        moved => {
            if (self.pressed) {
                // pixels moved upward since the previous event (length → float)
                let dy = (root.drag-last-y - self.mouse-y) / 1px;
                root.drag-last-y = self.mouse-y;
                let rate = (1.0 / root.drag-range) * (root.fine-drag ? 0.125 : 1.0);
                root.propose(root.fraction + dy * rate);
            }
        }
        scroll-event(ev) => {
            root.propose(root.fraction + (ev.delta-y > 0 ? 1 : -1) * root.step-fraction);
            return accept;
        }
        accessible-role: AccessibleRole.slider;
        accessible-label: "knob";
        accessible-value: round(root.value * 100) / 100;
    }

    // focus ring
    Rectangle {
        width: 100%; height: 100%;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: fs.has-focus ? root.accent : transparent;
        opacity: fs.has-focus ? 0.9 : 0.0;
    }

    // body dimming when disabled (after the focus ring so it tints all)
    Rectangle {
        width: 100%; height: 100%;
        border-radius: self.width / 2;
        background: #1A1D21;
        opacity: root.enabled ? 0.0 : 0.35;
    }

    function clamp-value(v: float) -> float {
        return Math.min(root.maximum, Math.max(root.minimum, v));
    }

    // propose a new sweep fraction: clamps, converts back to value units
    // (log-mapped when logarithmic) and emits through `changed`.
    function propose(f: float) {
        let fc = Math.min(1.0, Math.max(0.0, f));
        root.changed(clamp-value(root.value-from-fraction(fc)));
    }
}
