// Vector icons drawn with the `Path` element (viewbox 24×24) — font
// independent, themeable, crisp at any size. No icon font, no emoji.

import { Theme } from "theme.slint";

export component IconPlay inherits Path {
    in property <color> icon-color: Theme.text;
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 7 4 L 20 12 L 7 20 Z";
    fill: root.icon-color;
}

export component IconPause inherits Path {
    in property <color> icon-color: Theme.text;
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 6 4 L 10.5 4 L 10.5 20 L 6 20 Z M 13.5 4 L 18 4 L 18 20 L 13.5 20 Z";
    fill: root.icon-color;
}

export component IconStop inherits Path {
    in property <color> icon-color: Theme.text;
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 6 6 L 18 6 L 18 18 L 6 18 Z";
    fill: root.icon-color;
}

export component IconRewind inherits Path {
    in property <color> icon-color: Theme.text;
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 5 4 L 12 12 L 5 20 Z M 12 4 L 19 12 L 12 20 Z";
    fill: root.icon-color;
}

// Solid record dot; `live` selects filled red vs hollow.
export component IconRecordDot inherits Rectangle {
    in property <bool> live: false;
    width: 12px; height: 12px;
    border-radius: self.width / 2;
    background: live ? Theme.record : #00000000;
    border-width: 2px;
    border-color: live ? Theme.record : Theme.text-2nd;
}

// Import: tray with a down arrow into it.
export component IconImport inherits Path {
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 12 3 L 12 14 M 8 10.5 L 12 14.5 L 16 10.5 M 4 17 L 4 21 L 20 21 L 20 17";
    stroke: Theme.text;
    stroke-width: 2px;
    fill: transparent;
    fill-rule: nonzero;
}

// Export: an up arrow out of a tray.
export component IconExport inherits Path {
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 12 15 L 12 3 M 8 7 L 12 3 L 16 7 M 4 17 L 4 21 L 20 21 L 20 17";
    stroke: #FFFFFF;
    stroke-width: 2px;
    fill: transparent;
    fill-rule: nonzero;
}

export component IconZoomIn inherits Path {
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 10 3 C 14.4 3 18 6.6 18 11 C 18 15.4 14.4 19 10 19 C 5.6 19 2 15.4 2 11 C 2 6.6 5.6 3 10 3 Z M 15.5 16.5 L 21 22 M 7.5 11 L 12.5 11 M 10 8.5 L 10 13.5";
    stroke: Theme.text;
    stroke-width: 2px;
    fill: transparent;
    fill-rule: nonzero;
}

export component IconZoomOut inherits Path {
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 10 3 C 14.4 3 18 6.6 18 11 C 18 15.4 14.4 19 10 19 C 5.6 19 2 15.4 2 11 C 2 6.6 5.6 3 10 3 Z M 15.5 16.5 L 21 22 M 7.5 11 L 12.5 11";
    stroke: Theme.text;
    stroke-width: 2px;
    fill: transparent;
    fill-rule: nonzero;
}

// Fit: expanding brackets.
export component IconFit inherits Path {
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 9 3 L 3 3 L 3 9 M 15 3 L 21 3 L 21 9 M 9 21 L 3 21 L 3 15 M 15 21 L 21 21 L 21 15";
    stroke: Theme.text;
    stroke-width: 2px;
    fill: transparent;
    fill-rule: nonzero;
}

// Reset: circular arrow (counter-clockwise).
export component IconReset inherits Path {
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 12 4 C 16.4 4 20 7.6 20 12 C 20 16.4 16.4 20 12 20 C 7.6 20 4 16.4 4 12 C 4 8.8 5.9 6 8.7 4.7 M 4 3 L 4 8 L 9 8";
    stroke: Theme.text-2nd;
    stroke-width: 2px;
    fill: transparent;
    fill-rule: nonzero;
}

// Module glyphs (right panel headers)

// Pitch: tuning-fork-ish double sine.
export component IconPitch inherits Path {
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 2 12 C 4 4 6 4 8 12 C 10 20 12 20 14 12 C 16 4 18 4 20 12 M 20 12 L 20 21";
    stroke: Theme.accent;
    stroke-width: 2px;
    fill: transparent;
    fill-rule: nonzero;
}

// Air & breath: soft breeze waves.
export component IconAir inherits Path {
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 2 8 C 5 5 8 5 10 8 C 12 11 15 11 17 8 M 2 14 C 5 11 8 11 10 14 C 12 17 15 17 17 14 M 17 8 L 21 5 M 17 14 L 21 11";
    stroke: Theme.accent;
    stroke-width: 2px;
    fill: transparent;
    fill-rule: nonzero;
}

// Formant: vocal-tract tube (glottis block → tube → lips).
export component IconFormant inherits Path {
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 2 9 L 5 9 L 5 15 L 2 15 Z M 5 10.5 L 16 7.5 L 16 16.5 L 5 13.5 Z M 16 10.5 L 20 9 L 20 15 L 16 13.5";
    fill: Theme.accent;
}
