// Design tokens for the studio-rack redesign (Phase 7.2, Audioprecise
// Pro reference): "Dark Industrial Professional".
//
// Two-hue system, machined-hardware neutrals:
//   gold  = vocal / brand / engaged controls      (accent)
//   blue  = audio data (waveform, spectrum)       (wave-*/spectrum-*)
//   green = transport playing · red = record/clip · yellow = warning
//
// Surfaces are gunmetal, never pure black; panels carry a lighter top
// bevel edge (Theme.edge) and displays sit in near-black recessed wells
// (Theme.recess). Spacing stays on the 8-pt grid.

export global Theme {
    // Surfaces — dark industrial gunmetal
    out property <color> bg-base:   #1A1D21;   // app background (deep charcoal)
    out property <color> panel:     #242729;   // rack panel (dark gunmetal)
    out property <color> raised:    #2E3238;   // control surface / buttons
    out property <color> recess:    #131519;   // display wells, recessed tracks
    out property <color> border:    #3A3F45;   // panel borders (medium grey)
    out property <color> edge:      #4A5056;   // machined bevel highlight

    // Text (WCAG AA on bg-base / panel)
    out property <color> text:      #E0E4E8;
    out property <color> text-2nd:  #A8B0B8;
    out property <color> text-muted:#60666C;

    // Accent & semantics — gold is the vocal color
    out property <color> accent:     #E6B800;
    out property <color> accent-dim: #9C7E00;
    out property <color> accent-soft:#E6B8002E;   // ≈18 % selection fill
    out property <color> record:     #FF3333;
    out property <color> play:       #3FDE8B;
    out property <color> warn:       #ECC000;

    // Audio data displays — blue family
    out property <color> wave-peak:  #4A90E2;
    out property <color> wave-rms:   #4A90E28C;    // ≈55 % body
    out property <color> spectrum:   #2C7BE5;
    out property <color> spectrum-hi:#5BA3F5;
    out property <color> peak-cap:   #DCE8F5;      // spectrum/meter peak-hold caps
    out property <color> timecode:   #8CF5A0;      // green-tinted time display

    // Typography (embedded OFL fonts, registered via `import` in app-window.slint)
    out property <string> font-ui:     "IBM Plex Sans";
    out property <string> font-mono:   "IBM Plex Mono";
    out property <string> font-arabic: "IBM Plex Sans Arabic";

    // Geometry — 8-pt grid
    out property <length> radius-control: 3px;     // machined corners are tight
    out property <length> radius-panel:   4px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;

    // Control metrics
    out property <length> button-height: 32px;
    out property <length> nameplate-height: 52px;
    out property <length> statusbar-height: 26px;
    out property <length> transport-height: 60px;
    out property <length> analysis-width: 320px;

    // Motion (functional only)
    out property <duration> hover-fade: 120ms;
}
