// Micro-Vocal Lab — main window, studio-rack redesign (Phase 7.2,
// Audioprecise Pro reference).
//
// Layout (LTR default; mirrors under RTL except the transport cluster and
// the timeline itself — universal media conventions):
//
//   ┌ nameplate ─ MICRO VOCAL LAB · PROJECT file · [Import][Export][Devices]
//   ├ waveform rack ─ full-width overview strip (recessed well, blue trace)
//   ├ main row ─ [ PITCH | AIR | FORMANT channel strips ] [ RTA + LEVELS ]
//   ├ transport ─ ⏮ ▶ ⏹ ● + green timecode + zoom cluster
//   └ status bar ─ state LED · message · latency · EN | عربي
//
// Design language: machined gunmetal panels with corner screws and bevel
// edges, gold = vocal/brand/engaged, blue = audio data, recessed display
// wells, mono data typography. All strings go through @tr() — the
// English source strings are the default, the Arabic catalog ships in
// translations/ar/LC_MESSAGES.

import { Theme } from "theme.slint";
import { Translations } from "translations.slint";
// re-export so the controller can reach the global from Rust
export { Translations } from "translations.slint";
import { IconPlay, IconPause, IconStop, IconRewind, IconRecordDot,
         IconImport, IconExport, IconZoomIn, IconZoomOut, IconFit } from "icons.slint";
import { TextButton, IconButtonBase } from "widgets/buttons.slint";
import { ComboBox } from "std-widgets.slint";
import { WaveformView, RulerTick } from "widgets/waveform-view.slint";
import { ModuleCard } from "widgets/module-card.slint";
import { EqPanel, EqBandUi } from "widgets/eq-panel.slint";
export { EqBandUi }
import { RackPanel, ScrewHead, LedDot, EngravedLabel } from "widgets/rack.slint";
import { SpectrumView } from "widgets/spectrum-view.slint";
import { LevelMeter } from "widgets/level-meter.slint";

// Embedded fonts (OFL, docs §8.7) — registered on component creation.
import "../assets/fonts/IBMPlexSans-Regular.ttf";
import "../assets/fonts/IBMPlexSans-Medium.ttf";
import "../assets/fonts/IBMPlexSans-SemiBold.ttf";
import "../assets/fonts/IBMPlexSansArabic-Regular.ttf";
import "../assets/fonts/IBMPlexSansArabic-Medium.ttf";
import "../assets/fonts/IBMPlexSansArabic-SemiBold.ttf";
import "../assets/fonts/IBMPlexMono-Regular.ttf";
import "../assets/fonts/IBMPlexMono-Medium.ttf";

export component AppWindow inherits Window {
    default-font-family: Translations.font-family;
    default-font-size: 13px;
    title: @tr("Micro Vocal Lab");
    background: Theme.bg-base;
    min-width: 1080px;
    min-height: 856px;
    preferred-width: 1440px;
    preferred-height: 1086px;

    // ================= state published by the Rust controller ============

    // session
    in-out property <bool> has-audio: false;
    in-out property <string> file-name: "";
    in-out property <string> position-text: "00:00:00.000";
    in-out property <string> duration-text: "00:00:00.000";
    in-out property <string> rate-text: "—";
    in-out property <string> depth-text: "—";
    in-out property <string> preview-latency-text: "";

    // transport / capture
    in-out property <bool> playing: false;
    in-out property <bool> paused: false;
    in-out property <bool> recording: false;
    in-out property <string> recording-elapsed: "00:00";

    // status (key + preformatted, locale-neutral args)
    in-out property <string> status-key: "no-audio";
    in-out property <string> status-a1: "";
    in-out property <string> status-a2: "";
    in-out property <bool> busy: false;          // render/export/import running
    in-out property <int> export-progress: 0;

    // audio device picker (BUG 1/3: real selection, real effect)
    in-out property <bool> show-devices: false;
    in-out property <[string]> input-device-names: ["Auto"];
    in-out property <[string]> output-device-names: ["Auto"];
    in-out property <int> input-device-index: 0;
    in-out property <int> output-device-index: 0;
    in-out property <string> device-summary-text: "";

    // waveform view state
    in-out property <image> wave;
    in-out property <float> view-start: 0;
    in-out property <float> view-end: 1;
    in-out property <float> playhead: 0;
    in-out property <bool> show-playhead: false;
    in-out property <bool> has-selection: false;
    in-out property <float> sel-start: 0;
    in-out property <float> sel-end: 0;
    in-out property <[RulerTick]> ticks;
    in-out property <bool> sample-level: false;
    // canvas size (logical px) so the controller can re-render the peak
    // image at the right resolution
    out property <length> canvas-width: wf.canvas-width;
    out property <length> canvas-height: wf.canvas-height;

    // module values (canonical, Rust-owned)
    in-out property <float> pitch-semitones: 0;
    in-out property <int> air-percent: 0;
    in-out property <float> tract-mm: 170;
    in-out property <string> pitch-value-text: "+0.00";
    in-out property <string> pitch-detail-text: "";
    in-out property <string> air-value-text: "0.0";
    in-out property <string> air-detail-text: "";
    in-out property <int> air-meter-percent: 0;
    in-out property <string> tract-value-text: "170";
    in-out property <string> tract-detail-text: "";

    // analysis panel (RTA + levels, published at the UI tick rate from
    // mvl-core::spectrum over the preview mix at the playhead)
    in-out property <[float]> spectrum-bands;
    in-out property <[float]> spectrum-peaks;
    in-out property <float> level-l: 0;
    in-out property <float> level-r: 0;
    in-out property <float> level-peak-l: 0;
    in-out property <float> level-peak-r: 0;
    in-out property <bool> clip-latch: false;

    // parametric EQ (Phase 8.3): canonical state lives in the Rust
    // controller; the curve path strings are RBJ response math, computed
    // in Rust and handed over as SVG-ish path commands (viewbox 1000×260)
    in-out property <bool> eq-enabled: true;
    in-out property <bool> eq-active: false;
    in-out property <[EqBandUi]> eq-bands;
    in-out property <string> eq-curve-line: "";
    in-out property <string> eq-curve-fill: "";
    in-out property <int> eq-preset-index: 0;

    // ================= actions back into the controller ==================

    callback new-recording-clicked();
    callback import-clicked();
    callback export-clicked();
    callback rewind-clicked();
    callback play-pause-clicked();
    callback stop-clicked();
    callback seek-seconds(float);
    callback zoom-at(float, int);
    callback zoom-fit-clicked();
    callback select-seconds(float, float);
    callback canvas-resized();
    callback set-pitch(float);
    callback set-air(float);
    callback set-tract(float);
    callback commit-pitch-text(string);
    callback commit-air-text(string);
    callback commit-tract-text(string);
    callback reset-pitch();
    callback reset-air();
    callback reset-tract();
    callback set-language(string);
    callback devices-clicked();
    callback close-devices-clicked();
    callback set-input-device(string);
    callback set-output-device(string);
    callback set-eq-enabled(bool);
    callback band-param-changed(int, int, float);   // band, param, value
    callback band-toggled(int);
    callback eq-preset-chosen(int);
    callback reset-eq();

    // ================= layout ============================================

    VerticalLayout {
        spacing: 6px;
        padding: 6px;

        // ---- nameplate: machined rack strip ------------------------------
        Rectangle {
            height: Theme.nameplate-height;
            background: @linear-gradient(180deg, #2B2F34 0%, #242729 50%, #202329 100%);
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-panel;

            // bevel light
            Rectangle {
                x: 1px; y: 1px;
                width: parent.width - 2px;
                height: 1px;
                background: #FFFFFF1E;
            }

            ScrewHead { x: 6px; y: (parent.height - self.height) / 2; }
            ScrewHead { x: parent.width - self.width - 6px; y: (parent.height - self.height) / 2; }

            FlexboxLayout {
                alignment: LayoutAlignment.stretch;
                x: 24px; y: 0;
                width: parent.width - 48px;
                height: parent.height;
                flex-direction: Translations.rtl ? row-reverse : row;
                spacing: Theme.space-3;
                cross-axis-alignment: CrossAxisAlignment.center;

                // brand: gold pilot LED + engraved wordmark
                LedDot {
                    lit: true;
                    led-color: Theme.accent;
                    width: 9px; height: 9px;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }
                Text {
                    text: "MICRO VOCAL LAB";
                    color: Theme.text;
                    font-family: Theme.font-mono;
                    font-size: 14px;
                    font-weight: 600;
                    letter-spacing: 2.2px;
                    vertical-alignment: TextVerticalAlignment.center;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }

                // separator screw line
                Rectangle { width: 1px; height: 22px; background: Theme.border; cross-axis-self-alignment: CrossAxisAlignment.center; }

                // project readout
                Text {
                    text: @tr("PROJECT");
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                    vertical-alignment: TextVerticalAlignment.center;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }
                Text {
                    text: root.has-audio ? root.file-name : @tr("no file");
                    color: root.has-audio ? Theme.text-2nd : Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 12px;
                    vertical-alignment: TextVerticalAlignment.center;
                    overflow: elide;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }

                Rectangle { width: 12px; height: 1px; cross-axis-self-alignment: CrossAxisAlignment.center; }

                // import
                TextButton {
                    text: @tr("Import");
                    tooltip: @tr("Import File");
                    enabled: !root.busy && !root.recording;
                    clicked => { root.import-clicked(); }
                    cross-axis-self-alignment: CrossAxisAlignment.center;

                    IconImport {
                        width: 14px; height: 14px;
                        x: 9px;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // export (primary gold)
                TextButton {
                    text: @tr("Export");
                    tooltip: @tr("Export the processed audio");
                    primary: true;
                    enabled: root.has-audio && !root.busy && !root.recording;
                    clicked => { root.export-clicked(); }
                    cross-axis-self-alignment: CrossAxisAlignment.center;

                    IconExport {
                        width: 14px; height: 14px;
                        x: 9px;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // audio device picker
                TextButton {
                    text: @tr("Devices");
                    tooltip: @tr("Choose audio input and output devices");
                    enabled: !root.recording;
                    clicked => { root.devices-clicked(); }
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }
            }
        }

        // ---- waveform rack: full-width overview strip ---------------------
        Rectangle {
            vertical-stretch: 1;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-panel;

            Rectangle {
                x: 1px; y: 1px;
                width: parent.width - 2px;
                height: 1px;
                background: #FFFFFF14;
            }

            ScrewHead { x: 7px; y: 5px; }
            ScrewHead { x: parent.width - self.width - 7px; y: 5px; }

            VerticalLayout {
                padding: 4px;
                padding-top: 0px;
                spacing: 0;

                EngravedLabel {
                    text: @tr("WAVEFORM") + " · " + @tr("OVERVIEW");
                    height: 16px;
                    x: Theme.space-3;
                    vertical-alignment: TextVerticalAlignment.center;
                }

                wf := WaveformView {
                    wave: root.wave;
                    has-audio: root.has-audio;
                    view-start: root.view-start;
                    view-end: root.view-end;
                    playhead: root.playhead;
                    show-playhead: root.show-playhead;
                    has-selection: root.has-selection;
                    sel-start: root.sel-start;
                    sel-end: root.sel-end;
                    ticks: root.ticks;
                    sample-level: root.sample-level;
                    empty-hint: @tr("No audio loaded — import a file or record");
                    seek-seconds(t) => { root.seek-seconds(t); }
                    zoom-at(f, d) => { root.zoom-at(f, d); }
                    select-seconds(a, b) => { root.select-seconds(a, b); }
                    canvas-resized() => { root.canvas-resized(); }
                }
            }
        }

        // ---- EQ rack: 4-band parametric equalizer (Phase 8.3) -------------
        EqPanel {
            height: 196px;
            has-audio: root.has-audio;
            eq-enabled: root.eq-enabled;
            eq-active: root.eq-active;
            bands: root.eq-bands;
            curve-line: root.eq-curve-line;
            curve-fill: root.eq-curve-fill;
            preset-index <=> root.eq-preset-index;
            set-eq-enabled(on) => { root.set-eq-enabled(on); }
            band-param-changed(b, p, v) => { root.band-param-changed(b, p, v); }
            band-toggled(b) => { root.band-toggled(b); }
            preset-chosen(i) => { root.eq-preset-chosen(i); }
            reset-eq() => { root.reset-eq(); }
        }

        // ---- main row: channel strips + analysis rack ----------------------
        FlexboxLayout {
            flex-direction: Translations.rtl ? row-reverse : row;
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.stretch;
            height: 292px;

            // channel strips in a rack panel
            RackPanel {
                screws: true;
                horizontal-stretch: 1;

                FlexboxLayout {
                    x: Theme.space-2; y: 2px;
                    width: parent.width - 2 * Theme.space-2;
                    height: parent.height - 4px;
                    flex-direction: Translations.rtl ? row-reverse : row;
                    alignment: LayoutAlignment.stretch;
                    cross-axis-alignment: CrossAxisAlignment.stretch;
                    spacing: Theme.space-2;

                    pitch-card := ModuleCard {
                        icon-kind: 0;
                        title: @tr("Pitch");
                        unit: @tr("st");
                        value-text: root.pitch-value-text;
                        detail-text: root.pitch-detail-text;
                        slider-value: root.pitch-semitones;
                        minimum: -12; maximum: 12; neutral: 0;
                        step: 0.01; coarse-step: 0.1;
                        value-changed(v) => { root.set-pitch(v); }
                        value-committed(t) => { root.commit-pitch-text(t); }
                        reset-pressed() => { root.reset-pitch(); }
                    }
                    air-card := ModuleCard {
                        icon-kind: 1;
                        title: @tr("Air & Breath");
                        unit: @tr("dB");
                        value-text: root.air-value-text;
                        detail-text: root.air-detail-text;
                        slider-value: root.air-percent;
                        minimum: -100; maximum: 100; neutral: 0;
                        step: 0.5; coarse-step: 5;
                        show-meter: true;
                        meter-percent: root.air-meter-percent;
                        value-changed(v) => { root.set-air(v); }
                        value-committed(t) => { root.commit-air-text(t); }
                        reset-pressed() => { root.reset-air(); }
                    }
                    formant-card := ModuleCard {
                        icon-kind: 2;
                        title: @tr("Formant");
                        unit: @tr("mm");
                        value-text: root.tract-value-text;
                        detail-text: root.tract-detail-text;
                        slider-value: root.tract-mm;
                        minimum: 100; maximum: 260; neutral: 170;
                        step: 1; coarse-step: 10;
                        show-tract: true;
                        tract-fraction: (root.tract-mm - 100) / 160;
                        value-changed(v) => { root.set-tract(v); }
                        value-committed(t) => { root.commit-tract-text(t); }
                        reset-pressed() => { root.reset-tract(); }
                    }
                }
            }

            // analysis rack: RTA spectrum + master levels + session info
            RackPanel {
                screws: true;
                width: Theme.analysis-width;

                VerticalLayout {
                    y: 2px;
                    padding: Theme.space-2;
                    spacing: 6px;

                    EngravedLabel {
                        text: @tr("RTA ANALYZER");
                        height: 14px;
                    }

                    SpectrumView {
                        vertical-stretch: 1;
                        bands: root.spectrum-bands;
                        peaks: root.spectrum-peaks;
                        active: root.has-audio;
                        corner-label: @tr("PEAK HOLD");
                    }

                    // ---- master level section --------------------------------
                    EngravedLabel {
                        text: @tr("MASTER LEVEL");
                        height: 14px;
                    }

                    FlexboxLayout {
                        flex-direction: Translations.rtl ? row-reverse : row;
                        alignment: LayoutAlignment.stretch;
                        spacing: Theme.space-2;
                        height: 108px;

                        LevelMeter {
                            level: root.level-l;
                            peak: root.level-peak-l;
                            clip: root.clip-latch;
                            label: "L";
                            cross-axis-self-alignment: CrossAxisAlignment.stretch;
                        }
                        LevelMeter {
                            level: root.level-r;
                            peak: root.level-peak-r;
                            clip: root.clip-latch;
                            label: "R";
                            cross-axis-self-alignment: CrossAxisAlignment.stretch;
                        }

                        // session info block
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: @tr("Depth") + ": " + (root.has-audio ? root.depth-text : "—");
                                color: Theme.text-2nd;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                overflow: elide;
                            }
                            Text {
                                text: root.has-audio && root.preview-latency-text != ""
                                    ? @tr("Latency") + ": " + root.preview-latency-text
                                    : @tr("Latency") + ": —";
                                color: Theme.text-2nd;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                overflow: elide;
                            }
                            Text {
                                text: "40 · 20 Hz – 20 kHz";
                                color: Theme.text-muted;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // ---- transport bar: iconic controls + green timecode --------------
        Rectangle {
            height: Theme.transport-height;
            background: @linear-gradient(180deg, #2B2F34 0%, #242729 55%, #1F2226 100%);
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-panel;

            Rectangle {
                x: 1px; y: 1px;
                width: parent.width - 2px;
                height: 1px;
                background: #FFFFFF1E;
            }

            ScrewHead { x: 6px; y: parent.height - self.height - 6px; }
            ScrewHead { x: parent.width - self.width - 6px; y: parent.height - self.height - 6px; }

            FlexboxLayout {
                alignment: LayoutAlignment.stretch;
                x: 24px; y: 0;
                width: parent.width - 48px;
                height: parent.height;
                flex-direction: row;   // transport cluster stays LTR (media convention)
                spacing: Theme.space-2;
                cross-axis-alignment: CrossAxisAlignment.center;

                IconButtonBase {
                    tooltip: @tr("Rewind to start");
                    enabled: root.has-audio;
                    clicked => { root.rewind-clicked(); }
                    IconRewind { width: 18px; height: 18px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                }

                // big play / pause
                Rectangle {
                    width: 44px; height: 44px;
                    border-radius: 22px;
                    background: !root.has-audio ? #26292E
                        : (ta-play.has-hover || ta-play.pressed ? #4AE89E : Theme.play);
                    border-width: 2px;
                    border-color: !root.has-audio ? Theme.border : #1E7A4C;

                    ta-play := TouchArea {
                        enabled: root.has-audio;
                        clicked => { root.play-pause-clicked(); }
                        accessible-role: AccessibleRole.button;
                        accessible-label: root.playing ? @tr("Pause") : @tr("Play");
                    }
                    if root.playing: IconPause { icon-color: #10241A; width: 20px; height: 20px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                    if !root.playing: IconPlay { icon-color: #10241A; width: 20px; height: 20px; x: (parent.width - self.width)/2 + 1px; y: (parent.height - self.height)/2; }
                }

                IconButtonBase {
                    tooltip: @tr("Stop");
                    enabled: root.has-audio;
                    clicked => { root.stop-clicked(); }
                    IconStop { width: 16px; height: 16px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                }

                Rectangle { width: 10px; height: 1px; }

                // big record button (red when armed/live)
                Rectangle {
                    width: 44px; height: 44px;
                    border-radius: 22px;
                    background: root.recording
                        ? (ta-rec.has-hover ? #FF6666 : Theme.record)
                        : (ta-rec.has-hover || ta-rec.pressed ? #4A2A2A : #2E3238);
                    border-width: 2px;
                    border-color: root.recording ? #8A1414 : #5A3A3A;

                    ta-rec := TouchArea {
                        clicked => { root.new-recording-clicked(); }
                        accessible-role: AccessibleRole.button;
                        accessible-label: root.recording ? @tr("Stop Recording") : @tr("New Recording");
                    }
                    IconRecordDot {
                        width: 16px; height: 16px;
                        live: root.recording;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // recording elapsed (mono, red-tinted while live)
                if root.recording: Text {
                    text: root.recording-elapsed;
                    color: Theme.record;
                    font-family: Theme.font-mono;
                    font-size: 15px;
                    font-weight: 500;
                    vertical-alignment: TextVerticalAlignment.center;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }

                Rectangle { width: 16px; height: 1px; }

                // timecode: position (green, 18pt bold mono) / duration
                Text {
                    text: root.position-text;
                    color: Theme.timecode;
                    font-family: Theme.font-mono;
                    font-size: 19px;
                    font-weight: 600;
                    vertical-alignment: TextVerticalAlignment.center;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }
                Text {
                    text: "/";
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 13px;
                    vertical-alignment: TextVerticalAlignment.center;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }
                Text {
                    text: root.duration-text;
                    color: Theme.text-2nd;
                    font-family: Theme.font-mono;
                    font-size: 14px;
                    vertical-alignment: TextVerticalAlignment.center;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }
                Text {
                    text: root.rate-text;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    vertical-alignment: TextVerticalAlignment.center;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }

                Rectangle { height: 1px; horizontal-stretch: 1; }

                // zoom cluster
                IconButtonBase {
                    size: 34px;
                    tooltip: @tr("Zoom out");
                    enabled: root.has-audio;
                    clicked => { root.zoom-at(0.5, -1); }
                    IconZoomOut { width: 14px; height: 14px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                }
                IconButtonBase {
                    size: 34px;
                    tooltip: @tr("Zoom in");
                    enabled: root.has-audio;
                    clicked => { root.zoom-at(0.5, 1); }
                    IconZoomIn { width: 14px; height: 14px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                }
                IconButtonBase {
                    size: 34px;
                    tooltip: @tr("Fit whole file");
                    enabled: root.has-audio;
                    clicked => { root.zoom-fit-clicked(); }
                    IconFit { width: 14px; height: 14px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                }
            }
        }

        // ---- status bar -----------------------------------------------------
        Rectangle {
            height: Theme.statusbar-height;
            background: #1E2126;
            border-width: 1px;
            border-color: #14161A;
            border-radius: 3px;

            FlexboxLayout {
                alignment: LayoutAlignment.stretch;
                x: Theme.space-2; y: 0;
                width: parent.width - 2 * Theme.space-2;
                height: parent.height;
                flex-direction: Translations.rtl ? row-reverse : row;
                spacing: Theme.space-3;
                cross-axis-alignment: CrossAxisAlignment.center;

                // state LED: red = recording, green = playing, amber = paused
                LedDot {
                    width: 8px; height: 8px;
                    led-color: root.recording ? Theme.record
                        : root.playing ? Theme.play
                        : Theme.warn;
                    lit: root.recording || root.playing || root.paused;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }

                Text {
                    text: status-text();
                    color: Theme.text-2nd;
                    font-family: Translations.font-family;
                    font-size: 12px;
                    vertical-alignment: TextVerticalAlignment.center;
                    overflow: elide;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }

                Rectangle { height: 1px; horizontal-stretch: 1; }

                if root.preview-latency-text != "": Text {
                    text: root.preview-latency-text;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    vertical-alignment: TextVerticalAlignment.center;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }

                // language switcher: EN | عربي (native names, not translated)
                TextButton {
                    text: "EN";
                    min-w: 40px;
                    active: Translations.locale == "en";
                    tooltip: "English";
                    clicked => { root.set-language("en"); }
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }
                Text {
                    text: "|";
                    color: Theme.text-muted;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }
                TextButton {
                    text: "عربي";
                    min-w: 48px;
                    active: Translations.locale == "ar";
                    tooltip: "العربية";
                    clicked => { root.set-language("ar"); }
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                }
            }
        }
    }

    // ================= audio device dialog (BUG 1/3) =====================
    // Modal overlay: later siblings render above the main layout. The
    // ComboBoxes hold REAL device names published by the controller;
    // selecting one changes which device recording/playback opens.

    if root.show-devices: Rectangle {
        background: rgba(0, 0, 0, 0.55);
        TouchArea {
            // click on the scrim closes
            clicked => { root.close-devices-clicked(); }
        }

        RackPanel {
            screws: true;
            width: 480px;
            height: 340px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            TouchArea {
                // swallow clicks inside the dialog so the scrim does not
                // close it
            }

            VerticalLayout {
                padding: Theme.space-4;
                padding-top: 28px;
                spacing: Theme.space-2;

                Text {
                    text: @tr("Audio Devices");
                    color: Theme.text;
                    font-family: Translations.font-family;
                    font-size: 15px;
                    font-weight: 600;
                }

                EngravedLabel {
                    text: @tr("INPUT");
                    height: 12px;
                }
                ComboBox {
                    model: root.input-device-names;
                    current-index: min(root.input-device-index, root.input-device-names.length - 1);
                    selected(value) => { root.set-input-device(value); }
                    enabled: !root.recording;
                }

                EngravedLabel {
                    text: @tr("OUTPUT");
                    height: 12px;
                }
                ComboBox {
                    model: root.output-device-names;
                    current-index: min(root.output-device-index, root.output-device-names.length - 1);
                    selected(value) => { root.set-output-device(value); }
                }

                Text {
                    text: root.device-summary-text;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }

                Rectangle { height: 1px; }

                TextButton {
                    text: @tr("Close");
                    primary: true;
                    clicked => { root.close-devices-clicked(); }
                    cross-axis-self-alignment: Translations.rtl ? CrossAxisAlignment.start : CrossAxisAlignment.end;
                }
            }
        }
    }

    // ================= window-level keyboard shortcuts ====================

    FocusScope {
        width: 0px; height: 0px;   // zero-size: keyboard only, no layout impact
        key-pressed(ev) => {
            if (ev.text == Key.Space) {
                if (root.has-audio) {
                    root.play-pause-clicked();
                    return accept;
                }
            }
            return reject;
        }
    }

    // ================= Rust helpers =======================================

    // Canonical text for the editable value fields, pushed by the controller
    // after every value change so parse failures restore the true value.
    public function set-pitch-field(t: string) { pitch-card.set-field-text(t); }
    public function set-air-field(t: string) { air-card.set-field-text(t); }
    public function set-tract-field(t: string) { formant-card.set-field-text(t); }

    function status-text() -> string {
        if (status-key == "recording") {
            return @tr("Recording") + " " + root.status-a1 + " · " + root.status-a2;
        } else if (status-key == "rendering") {
            return @tr("Rendering") + " " + root.export-progress + " %";
        } else if (status-key == "exported") {
            return @tr("Exported") + " " + root.status-a1 + " (" + root.status-a2 + "× " + @tr("realtime") + ")";
        } else if (status-key == "import-error") {
            return @tr("Import failed") + ": " + root.status-a1;
        } else if (status-key == "export-error") {
            return @tr("Export failed") + ": " + root.status-a1;
        } else if (status-key == "no-input-device") {
            return @tr("No audio input device found")
                + (root.status-a1 != "" ? ": " + root.status-a1 : "");
        } else if (status-key == "no-output-device") {
            return @tr("No audio output device found")
                + (root.status-a1 != "" ? ": " + root.status-a1 : "");
        } else if (status-key == "no-audio") {
            return @tr("No audio loaded — import a file or record");
        } else if (status-key == "importing") {
            return @tr("Importing") + " " + root.status-a1;
        } else if (status-key == "audio-loaded") {
            return root.status-a1 + " · " + root.status-a2;
        }
        return @tr("Ready");
    }
}
